{
  "name": "@harrybob/swarm-cli",
  "version": "0.1.3",
  "description": "CLI swarm agent developer tool with multi-agent orchestration",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "swarm": "dist/index.js"
  },
  "files": [
    "dist/",
    "scripts/",
    "README.md"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest",
    "lint": "eslint src/",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "keywords": [
    "cli",
    "ai",
    "agents",
    "orchestration",
    "developer-tools",
    "swarm",
    "ollama"
  ],
  "license": "MIT",
  "author": "Harry Bob",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harry-bob/harrybob-swarm.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "dotenv": "^17.4.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "vitest": "^4.1.5"
  }
}
